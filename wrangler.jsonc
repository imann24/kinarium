{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinarium",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLDS",
        "class_name": "WorldRoom"
      },
      {
        "name": "DIRECTORY",
        "class_name": "WorldDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WorldRoom",
        "WorldDirectory"
      ]
    }
  ],
  "vars": {
    "LLM_ALLOWED_MODELS": "cf/meta/llama-3.1-8b-instruct-fp8,cf/meta/llama-3.2-3b-instruct,cf/mistralai/mistral-small-3.1-24b-instruct",
    "LLM_DAILY_CALL_LIMIT": "240",
    "LLM_DEFAULT_MODEL": "cf/meta/llama-3.1-8b-instruct-fp8",
    "LLM_PROVIDER": "cloudflare"
  },
  "observability": {
    "enabled": true
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "env": {
    // AI is deliberately not inherited: ordinary local development is offline.
    "local": {
      "name": "kinarium",
      "durable_objects": {
        "bindings": [
          {
            "name": "WORLDS",
            "class_name": "WorldRoom"
          },
          {
            "name": "DIRECTORY",
            "class_name": "WorldDirectory"
          }
        ]
      },
      "vars": {
        "LLM_PROVIDER": "disabled",
        "LLM_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
        "LLM_DAILY_CALL_LIMIT": "240"
      }
    }
  }
}
