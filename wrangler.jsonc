{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinarium", "main": "src/server/index.ts", "compatibility_date": "2025-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [ { "name": "WORLDS", "class_name": "WorldRoom" }, { "name": "DIRECTORY", "class_name": "WorldDirectory" } ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldRoom", "WorldDirectory"] }],
  "vars": { "LLM_BASE_URL": "https://ai-gateway.vercel.sh/v1", "LLM_MODEL": "openai/gpt-4o-mini", "LLM_DAILY_CALL_LIMIT": "24" },
  "observability": { "enabled": true }
}
