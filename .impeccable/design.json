  "narrative": {
    "northStar": "Neighborhood festival",
    "overview": "Kinarium’s landing route uses the neighborhood festival as its visual world: broad plum fields, pale yellow invitations, mint listing ground, and substantial display lettering. It feels sociable and curious, with real house illustrations providing the detail and personality.\n\nThis is a scoped landing identity, implemented in src/client/landing.css and the landing header and Directory in src/client/main.tsx. World screens, administration, existing dialogs, and the simulation renderer remain incumbent surfaces. Their DM Sans/Lora typography and semantic green/paper themes in src/client/style.css and src/client/theme.css are separate authority; do not migrate them to these tokens as an incidental extension.",
    "keyCharacteristics": [
      "Broad color fields and flat, open house listings.",
      "Dela Gothic One landmarks paired with Manrope reading and controls.",
      "An arched stage around the existing Building SVG, with recognizable house detail.",
      "The same color relationships in light and dark themes."
    ],
    "rules": [
      {
        "name": "The Scoped Identity Rule",
        "body": "Apply festival tokens to the landing and its header only; preserve the separate world and dialog systems.",
        "section": "colors"
      },
      {
        "name": "The House First Rule",
        "body": "Use the existing Building SVG for product illustrations; keep names, access conditions, and actions as readable interface text.",
        "section": "typography"
      },
      {
        "name": "The Flat Program Rule",
        "body": "Separate landing regions through color, space, and fine rules; use tonal change for listing hover.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the house name before its access label in featured invitations and listing copy.",
      "Do preserve visible keyboard focus, textual control names, and pressed filter states.",
      "Do keep long house names and descriptions wrapping inside their available columns.",
      "Do use the existing Building SVG and its theme-aware scene colors; font provenance and licenses live in public/fonts/README.md.",
      "Do honor reduced motion by disabling the house arrival animation."
    ],
    "donts": [
      "Don't apply the landing palette or display typography globally to world screens or existing dialogs.",
      "Don't turn the directory rows into a repeated elevated card grid.",
      "Don't introduce raster illustrations to replace the product’s existing house renderer.",
      "Don't promote existing dialog eyebrows or legacy decorative label styling into festival rules."
    ]
  }
}
