  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Standard participation and form action.",
      "html": "<button class=\"ds-primary\">Create a house</button>",
      "css": ".ds-primary { background:var(--action,#f4c455); color:var(--action-ink,#17284d); border:1px solid transparent; border-radius:var(--radius-control,6px); padding:12px 18px; min-height:44px; font:700 13px var(--font-body,Manrope,sans-serif); cursor:pointer; transition:background .2s; } .ds-primary:hover:not(:disabled) { background:var(--action-hover,#e5ab33); } .ds-primary:focus-visible { outline:3px solid var(--focus,#284e80); outline-offset:3px; } .ds-primary:disabled { cursor:default; opacity:.45; }"
    },
    {
      "name": "Outline action",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Secondary working action.",
      "html": "<button class=\"ds-outline\">World settings</button>",
      "css": ".ds-outline { background:var(--surface,#fff); color:var(--text,#17284d); border:1px solid var(--control-border,#6b7b96); border-radius:var(--radius-control,6px); padding:10px 13px; min-height:44px; font:650 12px var(--font-body,Manrope,sans-serif); cursor:pointer; } .ds-outline:hover:not(:disabled) { background:var(--surface-hover,#dce5f2); border-color:var(--accent,#284e80); } .ds-outline:focus-visible { outline:3px solid var(--focus,#284e80); outline-offset:3px; } .ds-outline:disabled { opacity:.45; cursor:default; }"
    },
    {
      "name": "Native field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labeled form input.",
      "html": "<label class=\"ds-label\">House name<input class=\"ds-input\" placeholder=\"Name your house\"></label>",
      "css": ".ds-label { display:grid; gap:8px; color:var(--text,#17284d); font:400 13px/1.6 var(--font-body,Manrope,sans-serif); } .ds-input { background:var(--surface,#fff); color:var(--text,#17284d); border:1px solid var(--control-border,#6b7b96); border-radius:var(--radius-control,6px); padding:11px 12px; min-height:44px; font:400 14px var(--font-body,Manrope,sans-serif); } .ds-input::placeholder { color:var(--muted,#4b5c78); opacity:1; } .ds-input:focus { border-color:var(--focus,#284e80); } .ds-input:focus-visible { outline:3px solid var(--focus,#284e80); outline-offset:3px; }"
    },
    {
      "name": "Directory filter",
      "kind": "button",
      "refersTo": "filter",
      "description": "Pressed filters select to navy.",
      "html": "<button class=\"ds-filter\" aria-pressed=\"true\">All houses</button>",
      "css": ".ds-filter { min-height:44px; padding:10px 16px; border:0; border-radius:6px; background:transparent; color:var(--secondary,#41516e); font:700 12px var(--font-body,Manrope,sans-serif); cursor:pointer; } .ds-filter[aria-pressed=true] { background:var(--stage,#17284d); color:var(--stage-ink,#f6f7fa); } .ds-filter:hover { box-shadow:inset 0 0 0 1px var(--control-border,#6b7b96); } .ds-filter:focus-visible { outline:3px solid var(--focus,#284e80); outline-offset:3px; }"
    },
    {
      "name": "Live state",
      "kind": "chip",
      "refersTo": "live-chip",
      "description": "Noninteractive factual world connection state.",
      "html": "<span class=\"ds-live\"><i></i>Live world</span>",
      "css": ".ds-live { display:inline-flex; align-items:center; gap:7px; background:var(--selected,#dce7f7); color:var(--selected-ink,#203f70); padding:9px 11px; border-radius:5px; font:650 11px/1.4 var(--font-body,Manrope,sans-serif); } .ds-live i { width:6px; height:6px; border-radius:50%; background:#849b6e; } @media(min-width:1251px) { .ds-live { min-width:124px; justify-content:center; font-size:14px; border-radius:10px; padding:8px 12px; } }"
    },
    {
      "name": "Masthead navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Navy navigation with saffron active rule.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary\"><a class=\"ds-nav-link\" href=\"#neighborhood\" aria-current=\"page\">The neighborhood</a><button class=\"ds-guide\">Field guide</button></nav>",
      "css": ".ds-nav { display:flex; align-items:center; gap:28px; height:58px; padding:0 28px; background:var(--stage,#17284d); color:var(--stage-ink,#f6f7fa); font:650 16px var(--font-body,Manrope,sans-serif); } .ds-nav-link { display:flex; align-items:center; height:58px; text-decoration:none; color:inherit; border-bottom:2px solid transparent; } .ds-nav-link[aria-current=page] { border-color:var(--saffron,#f4c455); } .ds-guide { min-height:44px; font:inherit; background:transparent; color:inherit; border:0; cursor:pointer; } .ds-nav a:hover,.ds-guide:hover { color:var(--stage-ink,#f6f7fa); } .ds-nav :focus-visible { outline:3px solid var(--saffron,#f4c455); outline-offset:3px; }"
    },
    {
      "name": "Event catalog choice",
      "kind": "card",
      "refersTo": "event-card",
      "description": "A flat bounded choice with catalog content.",
      "html": "<button class=\"ds-event\"><b>A shared meal</b><small>Make room at the table. Small connections have to start somewhere.</small></button>",
      "css": ".ds-event { display:flex; flex-direction:column; text-align:left; gap:12px; background:var(--surface,#fff); color:var(--text,#17284d); border:1px solid var(--line,#cbd4e2); border-radius:8px; padding:22px; box-shadow:none; cursor:pointer; max-width:320px; } .ds-event b { font:750 15px var(--font-body,Manrope,sans-serif); } .ds-event small { font:400 12px/1.65 var(--font-body,Manrope,sans-serif); color:var(--secondary,#41516e); } .ds-event:hover:not(:disabled) { background:var(--selected,#dce7f7); border-color:var(--control-border,#6b7b96); } .ds-event:focus-visible { outline:3px solid var(--focus,#284e80); outline-offset:3px; } .ds-event:disabled { opacity:.45; cursor:default; }"
    },
    {
      "name": "Program reading panel",
      "kind": "card",
      "refersTo": "program-panel",
      "description": "Journal program sheet with its wide heading variant.",
      "html": "<section class=\"ds-panel\"><h2>Life in the house</h2><p>Recorded moments appear here as the house story unfolds.</p></section>",
      "css": ".ds-panel { background:var(--surface,#fff); color:var(--text,#17284d); border:1px solid var(--line,#cbd4e2); border-radius:var(--radius-panel,12px); overflow:hidden; max-width:400px; } .ds-panel h2 { margin:0; padding:22px 20px 12px; font:400 36px/1.2 var(--font-display,Anton,sans-serif); text-transform:uppercase; letter-spacing:0; } .ds-panel p { margin:0; padding:0 20px 20px; font:400 14px/1.75 var(--font-body,Manrope,sans-serif); } @media(min-width:1251px) { .ds-panel h2 { padding:14px 18px 8px; font-size:40px; } }"
    },
    {
      "name": "Task dialog shell",
      "kind": "custom",
      "refersTo": "dialog",
      "description": "Shared single-scroll shell with a sticky close control, spacious inset and dialog-scale action. Task-specific widths are recorded in DESIGN.md.",
      "html": "<section class=\"ds-dialog\" role=\"dialog\" aria-labelledby=\"ds-dialog-title\"><div class=\"ds-dialog-content\"><button class=\"ds-dialog-close\" aria-label=\"Close\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button><h2 id=\"ds-dialog-title\">World settings</h2><p>These settings change the world for everyone.</p><button class=\"ds-dialog-primary\">Save world settings</button></div></section>",
      "css": ".ds-dialog { width:min(620px,calc(100vw - 48px)); max-height:calc(100dvh - 48px); overflow:auto; overscroll-behavior:contain; scrollbar-gutter:stable; scroll-padding-block:24px; background:var(--surface,#fff); color:var(--text,#17284d); border:1px solid var(--line,#cbd4e2); border-radius:16px; box-shadow:var(--shadow,0 16px 48px #14284b26); } .ds-dialog-content { display:flow-root; min-width:0; padding:var(--dialog-inset,40px); } .ds-dialog-close { position:sticky; float:right; top:16px; z-index:3; margin:-16px -16px 0 16px; background:var(--surface,#fff); color:var(--secondary,#41516e); width:44px; height:44px; display:inline-grid; place-items:center; border:0; border-radius:var(--radius-control,6px); cursor:pointer; } .ds-dialog-close:hover { background:var(--surface-hover,#dce5f2); color:var(--text,#17284d); } .ds-dialog-close:focus-visible { outline:3px solid var(--focus,#284e80); outline-offset:3px; } .ds-dialog h2 { margin:0 0 var(--section-gap,32px); padding-right:32px; font:400 32px/1.25 var(--font-display,Anton,sans-serif); letter-spacing:0; text-transform:uppercase; overflow-wrap:anywhere; } .ds-dialog p { font:400 13px/1.7 var(--font-body,Manrope,sans-serif); color:var(--muted,#4b5c78); } .ds-dialog-primary { min-height:48px; padding:12px 18px; background:var(--action,#f4c455); color:var(--action-ink,#17284d); border:1px solid transparent; border-radius:var(--radius-control,6px); font:700 14px var(--font-body,Manrope,sans-serif); cursor:pointer; } .ds-dialog-primary:hover:not(:disabled) { background:var(--action-hover,#e5ab33); } .ds-dialog-primary:focus-visible { outline:3px solid var(--focus,#284e80); outline-offset:3px; } .ds-dialog-primary:disabled { opacity:.45; cursor:default; } @media(max-width:600px) { .ds-dialog { width:calc(100vw - 24px); max-height:calc(100dvh - 24px); } .ds-dialog-content { padding:32px 24px 24px; } .ds-dialog-close { top:12px; margin:-16px -12px 0 8px; } .ds-dialog h2 { font-size:28px; padding-right:20px; } }"
    },
    {
      "name": "Dialog field",
      "kind": "input",
      "refersTo": "input-dialog",
      "description": "Dialog field variant with a 48px minimum control and the shared label/field rhythm.",
      "html": "<div class=\"ds-dialog-fields\"><label class=\"ds-dialog-label\">House name<input class=\"ds-dialog-input\" value=\"The Common House\"></label><label class=\"ds-dialog-label\">Description<textarea class=\"ds-dialog-textarea\" rows=\"3\">An open door, a pot of tea, and a few lives slowly intertwining.</textarea></label></div>",
      "css": ".ds-dialog-fields { display:grid; gap:var(--field-gap,24px); } .ds-dialog-label { display:grid; gap:var(--label-gap,8px); color:var(--text,#17284d); font:400 14px/1.6 var(--font-body,Manrope,sans-serif); } .ds-dialog-input,.ds-dialog-textarea { min-width:0; background:var(--surface,#fff); color:var(--text,#17284d); border:1px solid var(--control-border,#6b7b96); border-radius:var(--radius-control,6px); padding:11px 12px; font:400 14px var(--font-body,Manrope,sans-serif); } .ds-dialog-input { min-height:48px; } .ds-dialog-textarea { min-height:112px; padding:12px; line-height:1.65; resize:vertical; } .ds-dialog-input:focus,.ds-dialog-textarea:focus { border-color:var(--focus,#284e80); } .ds-dialog-input:focus-visible { outline:3px solid var(--focus,#284e80); outline-offset:3px; } .ds-dialog-textarea:focus-visible { outline:3px solid var(--focus,#284e80); outline-offset:3px; }"
    }
  ],
  "narrative": {
    "northStar": "Ensemble playhouse",
    "overview": "Kinarium puts the resident ensemble beside a live house stage. Navy frames the scene and navigation, cool white gives stories a readable program sheet, and saffron marks invitations to participate. Condensed Anton headings supply the playbill character; Manrope carries names, controls and sustained reading.\n\nThe user selected this world for the full interface redesign and approved the cast-beside-stage composition. House structure, furnishings and environmental colors may adapt to the interface; resident artwork and resident colors remain protected. The live SVG, actual residents, recorded stories and authoritative availability remain the content source.",
    "keyCharacteristics": [
      "Navy stage and navigation, cool white reading surfaces, and saffron actions.",
      "Anton program headings with Manrope identity, names, controls and prose.",
      "Visible cast, adjacent story desk, and direct access to house events.",
      "Modest corners, fine rules, flat panels, and related blue dark surfaces."
    ],
    "rules": [
      {
        "name": "The Resident Continuity Rule",
        "body": "Preserve resident artwork and colors; change environmental materials only within the authorized house renderer.",
        "section": "colors"
      },
      {
        "name": "The Program Type Rule",
        "body": "Use Anton for program landmarks and Manrope for names, controls and sustained reading.",
        "section": "typography"
      },
      {
        "name": "The Reading Surface Rule",
        "body": "Use tone, borders and space for ordinary panels; reserve floating depth for dialogs and contextual overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic light and dark roles from design-tokens.css for new interface surfaces.",
      "Do keep the live house renderer and the original resident art and colors.",
      "Do preserve visible focus, native field labels, pressed states and truthful disabled states.",
      "Do keep long names wrapping and full journal content reachable behind explicit disclosures.",
      "Do preserve observer identity, zoom, fullscreen, resident management and event access across responsive layouts.",
      "Do honor reduced motion for optional arrival and state animations."
    ],
    "donts": [
      "Don't restore the superseded green/tan/Dela interface world.",
      "Don't recolor resident sprites or replace them with generated portraits.",
      "Don't copy sample comp dialogue, counts or availability into production history.",
      "Don't turn directory listings and insights reading rows into elevated card grids.",
      "Don't introduce decorative eyebrows, glyph icons or prose border stripes as reusable conventions."
    ]
  }
