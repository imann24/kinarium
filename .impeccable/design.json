      "css": ".ds-tabs{display:flex;gap:4px;padding:6px;background:var(--surface-soft,#dce9cc);color:var(--secondary,#536047)}.ds-tabs button{flex:1;min-height:40px;padding:0 5px;border:0;border-radius:6px;background:transparent;color:inherit;font:11px Manrope,sans-serif;cursor:pointer}.ds-tabs button[aria-current=page]{background:var(--festival-plum,#43274f);color:var(--festival-yellow,#f2f3a6);font-weight:700}.ds-tabs button:hover{background:var(--surface-hover,#dce9cc)}.ds-tabs button[aria-current=page]:hover{background:var(--festival-plum,#43274f)}.ds-tabs button:focus-visible{outline:3px solid var(--focus,#43274f);outline-offset:4px}"
    },
    {
