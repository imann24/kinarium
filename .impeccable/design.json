  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Forest action in light mode; pale sage in dark mode.",
      "html": "<button class=\"ds-primary\" type=\"button\">Save house details</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 18px;background:var(--action,#3e5b43);color:var(--action-ink,#fffef8);border:1px solid transparent;border-radius:var(--radius-control,7px);font:700 13px Manrope,sans-serif;cursor:pointer;transition:background .2s}.ds-primary:hover:not(:disabled){background:var(--action-hover,#2d4733)}.ds-primary:focus-visible{outline:3px solid var(--focus,#3e5b43);outline-offset:3px}.ds-primary:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Outlined action on an ordinary surface.",
      "html": "<button class=\"ds-outline\" type=\"button\">Cancel</button>",
      "css": ".ds-outline{min-height:44px;padding:10px 13px;background:var(--surface,#fffef8);color:var(--text,#29382e);border:1px solid var(--control-border,#748168);border-radius:var(--radius-control,7px);font:650 12px Manrope,sans-serif;cursor:pointer}.ds-outline:hover:not(:disabled){background:var(--surface-hover,#dfe6d6);border-color:var(--accent,#3e5b43)}.ds-outline:focus-visible{outline:3px solid var(--focus,#3e5b43);outline-offset:3px}.ds-outline:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
      "name": "House name field",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label and native field on the semantic surface.",
      "html": "<label class=\"ds-field\">House name<input value=\"The common house\" required><small>Required · up to 60 characters</small></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;color:var(--text,#29382e);font:13px/1.6 Manrope,sans-serif}.ds-field input{min-height:44px;min-width:0;padding:11px 12px;border:1px solid var(--control-border,#748168);border-radius:var(--radius-control,7px);background:var(--surface,#fffef8);color:var(--text,#29382e);font:14px Manrope,sans-serif}.ds-field input:focus{border-color:var(--focus,#3e5b43)}.ds-field input:focus-visible{outline:3px solid var(--focus,#3e5b43);outline-offset:3px}.ds-field small{color:var(--muted,#596550);font-size:12px;line-height:1.65}"
    },
    {
      "name": "Directory filters",
      "kind": "chip",
      "refersTo": "filter",
      "description": "Sage selected state shared with working-surface choices.",
      "html": "<div class=\"ds-filters\"><button type=\"button\" aria-pressed=\"true\">All worlds</button><button type=\"button\" aria-pressed=\"false\">Open doors</button></div>",
      "css": ".ds-filters{display:flex;flex-wrap:wrap;gap:6px;padding:12px;background:var(--surface-soft,#e9ecdf)}.ds-filters button{min-height:44px;padding:10px 16px;border:1px solid transparent;border-radius:6px;background:transparent;color:var(--secondary,#52604e);font:700 12px Manrope,sans-serif;cursor:pointer}.ds-filters button[aria-pressed=true]{background:var(--selected,#dfe8d4);color:var(--selected-ink,#2c4a34)}.ds-filters button:hover{border-color:var(--text,#29382e)}.ds-filters button:focus-visible{outline:3px solid var(--text,#29382e);outline-offset:5px}"
    },
    {
      "name": "World view navigation",
      "kind": "nav",
      "description": "Quiet links with a persistent accent underline for the current view.",
      "html": "<nav class=\"ds-views\" aria-label=\"World views\"><a href=\"#world\" aria-current=\"page\">The world</a><a href=\"#insights\">Community insights</a></nav>",
      "css": ".ds-views{display:flex;flex-wrap:wrap;gap:8px;background:var(--page,#f4f3ec);font:600 13px Manrope,sans-serif}.ds-views a{display:flex;align-items:center;min-height:44px;padding:10px 12px;border-bottom:2px solid transparent;color:var(--secondary,#52604e);text-decoration:none}.ds-views a[aria-current=page]{color:var(--text,#29382e);border-color:var(--accent,#3e5b43)}.ds-views a:hover{background:var(--surface-soft,#e9ecdf)}.ds-views a:focus-visible{outline:3px solid var(--focus,#3e5b43);outline-offset:3px}"
    },
    {
      "name": "House narrative",
      "kind": "card",
      "refersTo": "house-narrative",
      "description": "Soft reading inset without a decorative prose stripe.",
      "html": "<article class=\"ds-narrative\"><h3>A little life together</h3><p>Conversations, shared routines and familiar faces shape life in the house.</p></article>",
      "css": ".ds-narrative{display:grid;grid-template-columns:1fr 2fr;gap:28px;padding:28px;background:var(--surface-soft,#e9ecdf);color:var(--text,#29382e);border:0;border-radius:var(--radius-panel,12px);font-family:Manrope,sans-serif}.ds-narrative h3{font-size:23px;font-weight:700;line-height:1.3;letter-spacing:-.025em;margin:10px 0 0}.ds-narrative p{margin:0 0 10px;font-size:15px;line-height:1.8;overflow-wrap:anywhere}@media(max-width:700px){.ds-narrative{grid-template-columns:1fr;gap:16px;padding:20px}.ds-narrative p{font-size:14px}}"
    },
    {
      "name": "Open event list item",
      "kind": "custom",
      "refersTo": "event-list-item",
      "description": "Ruled event item with tonal hover; distinct from the elevated event deck.",
      "html": "<button class=\"ds-event\" type=\"button\"><b>A shared meal</b><small>Make room at the table. Shared meals have a way of starting connections.</small></button>",
      "css": ".ds-event{display:flex;flex-direction:column;align-items:flex-start;gap:9px;max-width:300px;min-height:142px;padding:20px 32px 20px 0;text-align:left;background:transparent;color:var(--text,#29382e);border:0;border-top:1px solid var(--line,#c9d0be);border-radius:0;box-shadow:none;cursor:pointer}.ds-event b{font:700 15px Manrope,sans-serif}.ds-event small{color:var(--secondary,#52604e);font:12px/1.65 Manrope,sans-serif}.ds-event:hover:not(:disabled){background:var(--surface-soft,#e9ecdf);border-color:var(--control-border,#748168)}.ds-event:active:not(:disabled){background:var(--surface-hover,#dfe6d6)}.ds-event:focus-visible{outline:3px solid var(--focus,#3e5b43);outline-offset:3px}.ds-event:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
      "name": "Field guide disclosure",
      "kind": "custom",
      "description": "Bordered reading container with native details behavior and a soft open heading.",
      "html": "<details class=\"ds-guide\"><summary>What can I do here?<svg class=\"ds-chevron\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><p>Watch residents, explore their stories and bring an event into the house.</p></details>",
      "css": ".ds-guide{border:1px solid var(--line,#c9d0be);border-radius:12px;background:var(--surface,#fffef8);color:var(--text,#29382e);font-family:Manrope,sans-serif;transition:border-color .15s ease,background .15s ease}.ds-guide[open]{border-color:var(--control-border,#748168)}.ds-guide summary{display:flex;align-items:center;justify-content:space-between;gap:16px;list-style:none;padding:16px 20px;cursor:pointer;font-size:17px;line-height:1.35;border-radius:11px}.ds-guide summary::-webkit-details-marker{display:none}.ds-guide summary:hover,.ds-guide[open] summary{background:var(--surface-soft,#e9ecdf)}.ds-guide[open] summary{border-bottom:1px solid var(--line,#c9d0be);border-radius:11px 11px 0 0}.ds-guide summary:focus-visible{outline:3px solid var(--focus,#3e5b43);outline-offset:3px}.ds-guide p{padding:16px 20px 18px;margin:0;color:var(--secondary,#52604e);font-size:13.5px;line-height:1.75}.ds-chevron{color:var(--muted,#596550);transition:transform .2s ease}.ds-guide[open] .ds-chevron{transform:rotate(180deg);color:var(--accent,#3e5b43)}"
    }
  ],
  "narrative": {
    "northStar": "Natural-history diorama",
    "overview": "Kinarium frames a living miniature with warm ivory, oat and olive surfaces. Forest actions and pale sage selections relate the working interface to the existing house artwork. The house supplies the detail and personality; controls, navigation and reading surfaces remain calm and legible.\n\nThis system records the implemented overhaul after the user rejected the previous plum, mint and yellow combination. The natural-history framing is the implementation direction, not a separately user-approved mood board. The user explicitly confirmed retaining the existing artwork and rebuilding the UI around it; the Building SVG remains the product illustration. Dela Gothic One belongs to the wordmark and landing; Manrope carries the working application.",
    "keyCharacteristics": [
      "Warm neutral grounds, olive text, forest actions, and sage selections.",
      "Manrope for operational headings and reading; Dela for the brand and landing.",
      "Fine rules and open rows, with bounded panels where containment helps.",
      "Related olive-charcoal dark surfaces and explicit semantic state colors."
    ],
    "rules": [
      {
        "name": "The House First Rule",
        "body": "Let the existing house illustration carry the visual detail; use semantic interface colors to frame it.",
        "section": "colors"
      },
      {
        "name": "The Action and Selection Rule",
        "body": "Use action and action-ink for primary actions, selected and selected-ink for chosen filters, and danger, warning or good only for meaning.",
        "section": "colors"
      },
      {
        "name": "The Working Type Rule",
        "body": "Reserve Dela for the wordmark and landing; use Manrope for operational headings, controls and sustained reading.",
        "section": "typography"
      },
      {
        "name": "The Containment Rule",
        "body": "Use rules and space for ordinary reading and metrics; use bounded surfaces for the scene, journal, disclosures and dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic light and dark roles from design-tokens.css across new working surfaces.",
      "Do preserve visible focus, native field labels, pressed filter states and disabled behavior.",
      "Do keep long names and descriptions wrapping inside their available columns.",
      "Do use the existing Building SVG and preserve resident, furniture and semantic chart colors.",
      "Do honor reduced motion for the house arrival and event-deck animations."
    ],
    "donts": [
      "Don't restore the rejected plum, mint and yellow decorative combination.",
      "Don't carry the landing’s display typography or arched stage into everyday task screens.",
      "Don't turn metric rows and open directory listings into an elevated card grid.",
      "Don't add decorative eyebrows, glyph icons or prose border stripes as new system conventions.",
      "Don't replace the product’s house renderer with new raster illustrations."
    ]
  }
}
