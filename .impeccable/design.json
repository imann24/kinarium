  "components": [
    {
      "name": "Stage action",
      "kind": "button",
      "refersTo": "stage-action",
      "description": "Yellow invitation on the plum stage.",
      "html": "<div class=\"ds-stage\"><a class=\"ds-stage-action\" href=\"#house\">Visit this house<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></a></div>",
      "css": ".ds-stage{background:var(--festival-plum,#43274f);padding:20px}.ds-stage-action{display:inline-flex;align-items:center;justify-content:space-between;gap:22px;border:1px solid transparent;border-radius:7px;padding:15px 20px;min-height:49px;font:800 13px/1.5 Manrope,sans-serif;text-decoration:none;cursor:pointer;background:var(--festival-yellow,#f2f3a6);color:var(--festival-action-ink,#43274f)}.ds-stage-action:hover{background:var(--festival-action-hover,#fffec9)}.ds-stage-action:focus-visible{outline:3px solid var(--festival-yellow,#f2f3a6);outline-offset:5px}"
    },
    {
      "name": "Neighborhood action",
      "kind": "button",
      "refersTo": "button-neighborhood",
      "description": "Reversed ink and mint action on the directory ground.",
      "html": "<div class=\"ds-ground\"><button class=\"ds-neighborhood-action\" type=\"button\">Create a world<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></button></div>",
      "css": ".ds-ground{background:var(--festival-mint,#dce9cc);padding:20px}.ds-neighborhood-action{display:inline-flex;align-items:center;justify-content:space-between;gap:22px;border:1px solid transparent;border-radius:7px;padding:15px 20px;min-height:49px;font:800 13px/1.5 Manrope,sans-serif;text-decoration:none;cursor:pointer;background:var(--festival-ink,#35233d);color:var(--festival-mint,#dce9cc)}.ds-neighborhood-action:hover{opacity:.85}.ds-neighborhood-action:focus-visible{outline:3px solid var(--festival-ink,#35233d);outline-offset:5px}"
    },
    {
      "name": "World search",
      "kind": "input",
      "refersTo": "search",
      "description": "Transparent search with group focus.",
      "html": "<div class=\"ds-search-ground\"><label class=\"ds-search\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input type=\"search\" aria-label=\"Search worlds\" placeholder=\"Find a world…\"></label></div>",
      "css": ".ds-search-ground{background:var(--festival-mint,#dce9cc);padding:20px}.ds-search{display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--festival-ink,#35233d);padding-left:3px;width:280px;max-width:100%;color:var(--festival-ink,#35233d)}.ds-search input{width:100%;min-width:0;background:transparent;border:0;padding:14px 0;color:var(--festival-ink,#35233d);font:13px Manrope,sans-serif}.ds-search input::placeholder{color:var(--festival-subtle,#536047)}.ds-search:focus-within{outline:3px solid var(--festival-ink,#35233d);outline-offset:5px}.ds-search input:focus-visible{outline:none}"
    },
    {
      "name": "Directory filters",
      "kind": "chip",
      "refersTo": "filter",
      "description": "Labeled filter buttons showing selected and resting states.",
      "html": "<div class=\"ds-filters\"><button type=\"button\" aria-pressed=\"true\">All worlds</button><button type=\"button\" aria-pressed=\"false\">Open doors</button><button type=\"button\" aria-pressed=\"false\">Always on</button></div>",
      "css": ".ds-filters{display:flex;gap:6px;flex-wrap:wrap;background:var(--festival-mint,#dce9cc);padding:20px}.ds-filters button{min-height:44px;border:1px solid transparent;border-radius:6px;padding:10px 16px;font:700 12px Manrope,sans-serif;color:var(--festival-subtle,#536047);background:transparent;cursor:pointer}.ds-filters button[aria-pressed=true]{background:var(--festival-ink,#35233d);color:var(--festival-mint,#dce9cc)}.ds-filters button:hover{border-color:var(--festival-ink,#35233d)}.ds-filters button:focus-visible{outline:3px solid var(--festival-ink,#35233d);outline-offset:5px}"
    },
    {
      "name": "Shared app navigation",
      "kind": "nav",
      "refersTo": "app-navigation",
      "description": "Compact plum app navigation; the landing uses the taller header variant.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-current\" href=\"#worlds\" aria-current=\"page\">The worlds</a><button type=\"button\">Field guide</button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:30px;height:64px;padding:0 24px;background:var(--festival-plum,#43274f);color:var(--festival-lilac,#dacbe3);font:600 12px Manrope,sans-serif}.ds-nav a{height:64px;display:flex;align-items:center;position:relative;color:inherit;text-decoration:none}.ds-nav .ds-current:after{content:\"\";position:absolute;bottom:0;left:0;width:100%;height:3px;background:var(--festival-yellow,#f2f3a6)}.ds-nav button{font:inherit;color:inherit;border:0;background:none;padding:0;cursor:pointer}.ds-nav button:hover{color:var(--festival-yellow,#f2f3a6)}.ds-nav :is(a,button):focus-visible{outline:3px solid var(--festival-yellow,#f2f3a6);outline-offset:4px}"
    },
    {
      "name": "App primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Yellow primary action with fixed plum text in both themes.",
      "html": "<button class=\"ds-primary\" type=\"button\">Save house details</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:44px;padding:12px 18px;background:var(--festival-yellow,#f2f3a6);color:var(--festival-action-ink,#43274f);border:1px solid var(--festival-action-ink,#43274f);border-radius:7px;font:800 13px Manrope,sans-serif;box-shadow:none;cursor:pointer;transition:background .2s}.ds-primary:hover:not(:disabled){background:var(--festival-action-hover,#fffec9)}.ds-primary:focus-visible{outline:3px solid var(--focus,#43274f);outline-offset:4px}.ds-primary:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Quiet outlined action on the ordinary surface.",
      "html": "<button class=\"ds-outline\" type=\"button\">Cancel</button>",
      "css": ".ds-outline{min-height:44px;padding:10px 13px;background:var(--surface,#eef3e7);color:var(--text,#35233d);border:1px solid var(--control-border,#748168);border-radius:6px;font:700 11px Manrope,sans-serif;cursor:pointer}.ds-outline:hover:not(:disabled){background:var(--surface-hover,#dce9cc)}.ds-outline:focus-visible{outline:3px solid var(--focus,#43274f);outline-offset:4px}.ds-outline:disabled{opacity:.48;cursor:not-allowed}"
    },
    {
