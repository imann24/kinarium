      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;color:var(--secondary,#536047);font:700 12px Manrope,sans-serif}.ds-field input{min-height:44px;min-width:0;padding:11px 12px;border:1px solid var(--control-border,#748168);border-radius:6px;background:var(--surface,#eef3e7);color:var(--text,#35233d);font:14px Manrope,sans-serif;caret-color:var(--accent,#43274f)}.ds-field input:focus-visible{outline:3px solid var(--focus,#43274f);outline-offset:4px}.ds-field small{font-size:11px;font-weight:400;line-height:1.6}"
    },
