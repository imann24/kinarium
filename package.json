{
  "name": "kinarium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "wrangler dev --env local --port 8787",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "preview": "wrangler dev --env local --port 8787",
    "deploy": "pnpm build && wrangler deploy --env \"\"",
    "test:integration": "node scripts/integration.mjs",
    "test:residents": "node scripts/test-resident-persistence.mjs",
    "test:events": "node scripts/test-event-budget.mjs",
    "dev:server:ai": "wrangler dev --env \"\" --port 8787"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "obscenity": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0",
    "ws": "^8.18.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
